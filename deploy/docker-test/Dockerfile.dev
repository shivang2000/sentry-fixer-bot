# Local development image for alertforge.
#
# Pairs with docker-compose.dev.yml. Source is BIND-MOUNTED from the
# host at runtime — this image only carries OS dependencies and the
# alertforge-runner user. `bun install` runs inside the container so the
# resulting node_modules are Linux binaries (a host install on
# Mac/arm64 would leak the wrong artefacts into a Linux container).

FROM amazonlinux:2023

# Install the same OS deps that bootstrap-al2023.sh installs on EC2.
# This image is built with `context: ../..` so the script is copied in
# directly (no GitHub fetch).
COPY deploy/ec2/bootstrap-al2023.sh /tmp/bootstrap.sh
RUN bash /tmp/bootstrap.sh && rm -f /tmp/bootstrap.sh

# bootstrap-al2023.sh installs claude under /home/ec2-user/.nvm and symlinks
# /usr/local/bin/claude to it. ec2-user's home is mode 0700 so other users
# (alertforge-runner, who actually runs the chat/agent subprocesses) cannot follow
# the symlink. Open up traversal on the path components only — the binaries
# themselves are already mode 0755.
RUN chmod o+x /home/ec2-user

# Pre-create the bind-mount target AND every anonymous-volume mount
# point as alertforge-runner so the volumes inherit that ownership at first
# container start. Without this they'd be root-owned and the alertforge-runner
# subprocess in setup.sh couldn't write into them.
RUN install -d -o alertforge-runner -g alertforge-runner \
      /opt/alertforge \
      /opt/alertforge/current \
      /opt/alertforge/current/node_modules \
      /opt/alertforge/current/apps \
      /opt/alertforge/current/apps/server \
      /opt/alertforge/current/apps/server/node_modules \
      /opt/alertforge/current/apps/server/dist \
      /opt/alertforge/current/apps/server/public \
      /opt/alertforge/current/apps/web \
      /opt/alertforge/current/apps/web/node_modules \
      /opt/alertforge/current/apps/web/dist \
      /opt/alertforge/current/packages \
      /opt/alertforge/current/packages/api/node_modules \
      /opt/alertforge/current/packages/auth/node_modules \
      /opt/alertforge/current/packages/config/node_modules \
      /opt/alertforge/current/packages/db/node_modules \
      /opt/alertforge/current/packages/env/node_modules \
      /opt/alertforge/current/packages/ui/node_modules

# /alertforge/state is the SINGLE persistent volume that holds every piece of
# mutable per-instance state — alertforge-runner's HOME (so every CLI's dotfiles
# naturally land in the volume: .claude, .config/gh, .codex, .opencloud,
# .npm, .cache), the UI-mutated env file under etc/env, per-session work
# dirs, and uploaded skills. One named volume = one disk artefact to
# backup later, no per-tool wiring as we add more CLIs.
RUN install -d -o alertforge-runner -g alertforge-runner -m 0700 \
      /alertforge \
      /alertforge/state \
      /alertforge/state/home \
      /alertforge/state/home/.claude \
      /alertforge/state/home/.config \
      /alertforge/state/home/.config/gh \
      /alertforge/state/home/.npm \
      /alertforge/state/home/.cache \
      /alertforge/state/work \
      /alertforge/state/skills \
      /alertforge/state/dev \
      /alertforge/state/repos \
 && install -d -o root -g alertforge-runner -m 0770 /alertforge/state/etc

WORKDIR /opt/alertforge/current

ENV ALERTFORGE_RUN_MODE=container \
    ALERTFORGE_STATE_DIR=/alertforge/state \
    NODE_ENV=development \
    PATH=/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin

EXPOSE 3000

# setup.sh runs as root, handles bun install / migrate / build as
# alertforge-runner internally, then exec's the server as PID 1 so logs
# stream to `docker compose logs -f`.
CMD ["bash", "/opt/alertforge/current/setup.sh"]
