{
  "name": "sentry-fixer-bot",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "packages/sources/*",
      "packages/channels/*",
      "packages/steps/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^6",
      "@types/bun": "^1.3.4",
      "hono": "^4.8.2",
      "@trpc/server": "^11.16.0",
      "better-auth": "1.6.9",
      "next-themes": "^0.4.6",
      "@trpc/client": "^11.16.0",
      "@types/react-dom": "^19.2.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build && bun run build:web-into-server",
    "build:web-into-server": "mkdir -p apps/server/public && rm -rf apps/server/public/* apps/server/public/.[!.]* 2>/dev/null ; cp -R apps/web/dist/. apps/server/public/",
    "check-types": "turbo check-types",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @sentry-fixer-bot/db db:push",
    "db:studio": "turbo -F @sentry-fixer-bot/db db:studio",
    "db:generate": "turbo -F @sentry-fixer-bot/db db:generate",
    "db:migrate": "turbo -F @sentry-fixer-bot/db db:migrate",
    "db:seed": "turbo -F @sentry-fixer-bot/db db:seed",
    "db:start": "turbo -F @sentry-fixer-bot/db db:start",
    "db:watch": "turbo -F @sentry-fixer-bot/db db:watch",
    "db:stop": "turbo -F @sentry-fixer-bot/db db:stop",
    "db:down": "turbo -F @sentry-fixer-bot/db db:down",
    "check": "biome check --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "@sentry-fixer-bot/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@sentry-fixer-bot/config": "workspace:*",
    "@types/bun": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "shadcn": "^4.7.0",
    "turbo": "^2.8.12",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "biome check --write ."
    ]
  },
  "packageManager": "bun@1.3.5"
}
